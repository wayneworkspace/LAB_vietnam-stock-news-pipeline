# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
ANTHROPIC_API_KEY=

# --- Optional settings (the defaults are shown) ---

# Expose the /debug/* endpoints used to fix parsers. Keep this false for a real deployment.
ENABLE_DEBUG_ENDPOINTS=false

# Incremental price loads re-fetch (days since the last stored price) + this many days.
PRICE_LOOKBACK_DAYS=3

# News published at or after this time (VN time) counts for the NEXT trading session.
# HOSE: the closing auction (ATC) ends at 14:45.
MARKET_CLOSE_TIME=14:45

# Prompt version that Gold (and so the digest) reads. Promote it only after /enrich-news has
# scored every news item with the new PROMPT_VERSION (see transform/prompts.py).
ACTIVE_PROMPT_VERSION=v1

# Export the Gold tables to Parquet after every /build-gold (fact tables partitioned by date).
EXPORT_PARQUET=true
