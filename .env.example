# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
ANTHROPIC_API_KEY=

# Expose the /debug/* endpoints used to fix parsers. Keep this false for a real deployment.
ENABLE_DEBUG_ENDPOINTS=false

# Prompt version that Gold (and so the digest) reads. Promote it only after /enrich-news has
# scored every news item with the new PROMPT_VERSION (see python/transform/prompts.py).
ACTIVE_PROMPT_VERSION=v1
